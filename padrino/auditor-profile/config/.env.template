# Auditor Profile — Environment Variables
# =============================================================================
# Copy this file to ~/.hermes_auditor/.env and fill in your values.
# Permissions: chmod 600 ~/.hermes_auditor/.env
#
# This file contains READ-ONLY tokens for the code auditor profile.
# NEVER use tokens with write access — the auditor must not modify repos.
# =============================================================================

# ---------------------------------------------------------------------------
# Git Read-Only Tokens
# ---------------------------------------------------------------------------
# GitHub: Create a fine-grained personal access token with:
#   - Repository access: Only selected repositories
#   - Permissions: Contents (Read-only), Metadata (Read-only)
#   - https://github.com/settings/tokens?type=beta
GIT_READONLY_TOKEN=[COMPLETAR]

# ---------------------------------------------------------------------------
# GitLab (optional)
# ---------------------------------------------------------------------------
# GITLAB_READONLY_TOKEN=[COMPLETAR]

# ---------------------------------------------------------------------------
# Audit Configuration
# ---------------------------------------------------------------------------
# Maximum number of findings per audit (default: 50)
AUDIT_MAX_FINDINGS=50

# Maximum files to analyze per audit (prevents analysis of massive repos)
AUDIT_MAX_FILES=500

# Timeout for static analysis tools (seconds)
AUDIT_TOOL_TIMEOUT=300

# ---------------------------------------------------------------------------
# Report Storage
# ---------------------------------------------------------------------------
# Where audit reports are stored
AUDIT_REPORTS_DIR=~/.hermes_auditor/reports/code-audits

# ---------------------------------------------------------------------------
# NOTE: This profile does NOT use:
#   - HERMES_TELEGRAM_TOKEN (no Telegram gateway)
#   - Model API keys from main padrino (uses its own)
#   - PADRINO_BACKUP_KEY (no backup operations)
#   - Any personal database credentials
# =============================================================================

# Hermes Agent Configuration — Padrino Digital
# =============================================================================
# Copy this file to /home/padrino/.hermes/.env and fill in your values.
#
#   cp config/.env.template /home/padrino/.hermes/.env
#   chmod 600 /home/padrino/.hermes/.env
#   chown padrino:padrino /home/padrino/.hermes/.env
#
# WARNING: This file contains secrets. NEVER commit real values.
#          NEVER include secrets in LLM context or error messages.
# =============================================================================

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to interact with the bot
# Leave empty to allow any user (NOT recommended for production)
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Model Provider Configuration
# ---------------------------------------------------------------------------
# Supported providers: openai, anthropic, groq, ollama, openrouter, together
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Optional: model-specific overrides
# LLM_MAX_TOKENS=
# LLM_TEMPERATURE=
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Padrino Digital Paths
# ---------------------------------------------------------------------------
PADRINO_DATA_DIR=/srv/padrino/data
PADRINO_DB_PATH=/srv/padrino/data/padrino.db

# ---------------------------------------------------------------------------
# Backup Encryption Key (GPG symmetric, AES-256)
# ---------------------------------------------------------------------------
# Generate a strong key and NEVER commit it:
#   openssl rand -base64 32
PADRINO_BACKUP_KEY=

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
